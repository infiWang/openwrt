#include "mt7988a-buffalo-wxr18000be10p.dtsi"

/ {
    model = "Buffalo WXR18000BE10P (OpenWrt U-Boot layout)";
    compatible = "buffalo,wxr18000be10p-ubootmod", "mediatek,mt7988a";

    chosen {
        rootdisk = <&ubi_rootdisk>;
        stdout-path = "serial0:115200n1";
    };
};

&spi_nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			reg = <0x0 0x200000>;
			label = "bl2";
			read-only;
		};

		partition@100000 {
			reg = <0x200000 0xfe00000>;
			label = "UBI_DEV";
            compatible = "linux,ubi";

            volumes {
				ubi-volume-ubootenv {
					volname = "ubootenv";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi-volume-ubootenv2 {
					volname = "ubootenv2";
					nvmem-layout {
						compatible = "u-boot,env-redundant-bool";
					};
				};

				ubi_rootdisk: ubi-volume-fit {
					volname = "fit";
				};

				ubi_factory: ubi-volume-factory {
					volname = "factory";
				};
			};
		};
	};
};

&ubi_factory {
    BUFFALO_WXR18000BE10P_FACTORY_LAYOUT;
};

&gmac0 {
    nvmem-cells = <&macaddr_factory_ffff4>;
    nvmem-cell-names = "mac-address";
};

&gmac1 {
    nvmem-cells = <&macaddr_factory_ffff4>;
    nvmem-cell-names = "mac-address";
};

&gmac2 {
    nvmem-cells = <&macaddr_factory_ffff4>;
    nvmem-cell-names = "mac-address";
};

&mt7996_wifi {
    #address-cells = <1>;
    #size-cells = <0>;
    nvmem-cells = <&eeprom_factory_0>;
    nvmem-cell-names = "eeprom";
	
    band@0 {
        /* 2.4 GHz */
        reg = <0>;
        nvmem-cells = <&macaddr_factory_4>;
        nvmem-cell-names = "mac-address";
    };

    band@1 {
        /* 5 GHz */
        reg = <1>;
        nvmem-cells = <&macaddr_factory_a>;
        nvmem-cell-names = "mac-address";
    };

    band@2 {
        /* 6 GHz */
        reg = <2>;
        nvmem-cells = <&macaddr_factory_2c0>;
        nvmem-cell-names = "mac-address";
    };
};